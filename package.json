{
  "name": "agy-agent-acp",
  "version": "0.1.2",
  "description": "Agent Client Protocol (ACP) adapter for Google Antigravity CLI (agy)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agy-agent-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "antigravity",
    "agy",
    "google-deepmind",
    "ai-agents",
    "agentic-ai",
    "mcp"
  ],
  "author": "Dong Tran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongitran/agy-agent-acp.git"
  },
  "bugs": {
    "url": "https://github.com/dongitran/agy-agent-acp/issues"
  },
  "homepage": "https://github.com/dongitran/agy-agent-acp#readme",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
